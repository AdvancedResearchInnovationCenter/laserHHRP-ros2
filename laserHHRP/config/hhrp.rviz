# RViz 2 layout of the operator UI (launch/ui.launch.py): operator panel on the left, 3D view on the right.
# 3D view: the live laser profile (/laser/profile) and the 3D scan (/scan/cloud_view, from point_cloud_node),
# plus the hole and rivet detection displays (hole_detector; only the running mode publishes).
# Which start shown: config/rviz_displays.yaml.
Panels:
  - Class: laser_hhrp/OperatorPanel
    Name: Operator
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.01
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Axes
      Name: Laser frame
      Enabled: true
      Length: 0.02
      Radius: 0.002
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Live profile
      Enabled: true
      Topic:
        Value: /laser/profile
        Depth: 5
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 0; 255; 0
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: 3D scan
      Enabled: true
      Topic:
        Value: /scan/cloud_view
        Depth: 5
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
      Value: true
    # ---- hole detection (hole_detector package); on/off at start: config/rviz_displays.yaml ----
    - Class: rviz_default_plugins/PointCloud2
      Name: Hole surface
      Enabled: true
      Topic:
        Value: /holes/surface
        Depth: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 2
      Color Transformer: Intensity
      Channel Name: deviation_mm
      Use rainbow: true
      Invert Rainbow: false
      Autocompute Intensity Bounds: false
      Min Intensity: -1
      Max Intensity: 1
      Decay Time: 600
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Scan progress
      Enabled: true
      Topic:
        Value: /holes/progress
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Holes
      Enabled: true
      Topic:
        Value: /holes/markers
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Fitted circles
      Enabled: false
      Topic:
        Value: /holes/circles
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Style: Points
      Size (Pixels): 4
      Color Transformer: Intensity
      Channel Name: hole_id
      Use rainbow: true
      Autocompute Intensity Bounds: true
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Boundary
      Enabled: true
      Topic:
        Value: /holes/boundary
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 2
      Color Transformer: Intensity
      Channel Name: hole_id
      Use rainbow: true
      Autocompute Intensity Bounds: true
      Decay Time: 100000
      Value: true
    - Class: rviz_default_plugins/PoseArray
      Name: Hole axes
      Enabled: true
      Shape: Axes
      Axes Length: 0.008
      Axes Radius: 0.0006
      Topic:
        Value: /holes/poses
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Rivet surface
      Enabled: true
      Topic:
        Value: /rivets/surface
        Depth: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 2
      Color Transformer: Intensity
      Channel Name: deviation_mm
      Use rainbow: true
      Invert Rainbow: false
      Autocompute Intensity Bounds: false
      Min Intensity: -0.3
      Max Intensity: 0.3
      Decay Time: 600
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Rivet progress
      Enabled: true
      Topic:
        Value: /rivets/progress
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Rivets
      Enabled: true
      Topic:
        Value: /rivets/markers
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Rivet circles
      Enabled: false
      Topic:
        Value: /rivets/circles
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Style: Points
      Size (Pixels): 4
      Color Transformer: Intensity
      Channel Name: rivet_id
      Use rainbow: true
      Autocompute Intensity Bounds: true
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Rivet boundary
      Enabled: true
      Topic:
        Value: /rivets/boundary
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 2
      Color Transformer: Intensity
      Channel Name: rivet_id
      Use rainbow: true
      Autocompute Intensity Bounds: true
      Decay Time: 100000
      Value: true
    - Class: rviz_default_plugins/PoseArray
      Name: Rivet axes
      Enabled: true
      Shape: Axes
      Axes Length: 0.008
      Axes Radius: 0.0006
      Topic:
        Value: /rivets/poses
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Value: true
  Global Options:
    Fixed Frame: laser
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 0.25
      Focal Point: { X: 0, Y: 0, Z: 0.05 }
      Pitch: 0.5
      Yaw: 0.8
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
Window Geometry:
  X: 0
  Y: 0
  Width: 1280
  Height: 720
  Hide Left Dock: false
  Hide Right Dock: true
  Displays:
    collapsed: true
  Operator:
    collapsed: false
